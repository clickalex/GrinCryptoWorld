# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
# Leave empty to use the built-in persisted in-memory MongoDB-compatible store (dev/preview).
# Set to a real MongoDB connection string in production, e.g. mongodb://127.0.0.1:27017/grincrypto
MONGODB_URI=
MONGODB_DB=grincrypto
MEMORY_DB_PATH=../data/memory-db.json

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- CoinGecko ----
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_TIMEOUT_MS=8000

# ---- Payments (NowPayments / CoinPayments) ----
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=dev-ipn-secret
COINPAYMENTS_PUBLIC_KEY=
COINPAYMENTS_PRIVATE_KEY=
PAYMENT_ADDRESS=0x0000000000000000000000000000000000000000
 transaction = verify real on-chain ETH transfers| transaction = verify real on-chain ETH transfers
PAYMENTS_MODE=signature
ETHEREUM_RPC_URL=https://cloudflare-eth.com

# ---- Email (SMTP) ----
# e.g. smtp://user:pass@smtp.host.com:587 — leave empty to log emails to console (dev)
SMTP_URL=
SMTP_FROM=GrinCryptoWorld <no-reply@grincrypto.world>
# Public URL of the frontend (used in reset/verification email links)
WEB_APP_URL=http://localhost:3000

# ---- Notifications ----
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ---- AI (OpenAI) ----
OPENAI_API_KEY=

# ---- Seeding ----
SEED_ON_BOOT=true
# In production: leave empty to auto-generate + print a random admin password,
# or set your own. Demo accounts (seller@/demo@) are only created in development.
ADMIN_PASSWORD=

# ---- Ops ----
# Set to true ONLY for automated tests (disables login rate limits). Never enable in production.
RATE_LIMIT_OFF=false
